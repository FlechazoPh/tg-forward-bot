#!/usr/bin/env python3
"""tgsend - send a video to the TG group via the local Bot API server.

Usage: tgsend <video_path> <tweet_url> <tweet_text> <author_name> <author_handle>

- Probes real width/height/duration with ffprobe and passes them explicitly,
  so Telegram never stretches the picture (fixes the 320x320 misdetect).
- Caption (HTML): tweet text hyperlinked to the original post, then the
  author's name, then #hashtags for search.
"""
import html
import json
import os
import random
import subprocess
import sys
import time

DIR = os.path.expanduser("~/workspace/tools/tgapi")
API = "http://127.0.0.1:8081"

# Anti-flood: min seconds between sends, 429 backoff
MIN_SEND_INTERVAL = 5
LAST_SEND_FILE = os.path.join(DIR, "data", ".last_send")
MAX_SEND_RETRIES = 3


def rate_limit():
    """Ensure at least MIN_SEND_INTERVAL seconds between sends."""
    try:
        last = float(open(LAST_SEND_FILE).read().strip())
    except (FileNotFoundError, ValueError):
        last = 0
    wait = MIN_SEND_INTERVAL - (time.time() - last)
    if wait > 0:
        time.sleep(wait + random.uniform(0, 2))
    os.makedirs(os.path.dirname(LAST_SEND_FILE), exist_ok=True)
    open(LAST_SEND_FILE, "w").write(str(time.time()))


def ffprobe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error",
         "-show_entries", "stream=width,height",
         "-show_entries", "format=duration",
         "-of", "json", path],
        capture_output=True, text=True, check=True).stdout
    d = json.loads(out)
    st = d["streams"][0]
    return int(st["width"]), int(st["height"]), int(float(d["format"]["duration"]))


def main():
    if len(sys.argv) != 6:
        print("usage: tgsend <video> <tweet_url> <tweet_text> <author_name> <author_handle>",
              file=sys.stderr)
        sys.exit(2)
    video, tweet_url, tweet_text, author_name, author_handle = sys.argv[1:6]
    token = open(os.path.join(DIR, ".bot_token")).read().strip()
    chat = open(os.path.join(DIR, ".chat_id")).read().strip()
    w, h, dur = ffprobe(video)

    handle_tag = author_handle.lstrip("@")
    name_tag = "".join(author_name.split())
    caption = (
        f'<a href="{html.escape(tweet_url, quote=True)}">{html.escape(tweet_text)}</a>'
        f'\n\n博主：{html.escape(author_name)} @{html.escape(handle_tag)}'
        f'\n#{handle_tag} #{name_tag} #X视频下载'
    )

    # NOTE: use --form-string (not -F) for text fields: -F treats a value
    # starting with '<' as @<file and one starting with '@' as @file,
    # which breaks HTML captions like '<a href=...>' (curl error 26).
    rate_limit()
    last_err = None
    for attempt in range(MAX_SEND_RETRIES):
        r = subprocess.run(
            ["curl", "-s", "-m", "1800", "-X", "POST",
             f"{API}/bot{token}/sendVideo",
             "--form-string", f"chat_id={chat}",
             "--form-string", "parse_mode=HTML",
             "--form-string", "supports_streaming=true",
             "--form-string", f"width={w}",
             "--form-string", f"height={h}",
             "--form-string", f"duration={dur}",
             "--form-string", f"caption={caption}",
             "-F", f"video=@{video}"],
            capture_output=True, text=True)
        try:
            d = json.loads(r.stdout)
        except Exception:  # noqa: BLE001
            last_err = {"ok": False, "error": "bad response",
                        "rc": r.returncode,
                        "stderr": r.stderr[-200:],
                        "raw": r.stdout[:200]}
            time.sleep(min(2 ** attempt, 30) + random.uniform(0, 3))
            continue
        if d.get("ok"):
            v = d["result"].get("video", {})
            print(json.dumps({"ok": True, "message_id": d["result"]["message_id"],
                              "width": v.get("width"), "height": v.get("height"),
                              "duration": v.get("duration"),
                              "size": v.get("file_size")}, ensure_ascii=False))
            return
        # 429 flood control: respect retry_after
        err = d.get("description", "")
        retry_after = d.get("parameters", {}).get("retry_after")
        if d.get("error_code") == 429 and retry_after:
            time.sleep(retry_after + random.uniform(1, 3))
            continue
        last_err = d
        time.sleep(min(2 ** attempt, 30) + random.uniform(0, 3))
    print(json.dumps({"ok": False, "error": last_err}, ensure_ascii=False)[:500])
    sys.exit(1)


if __name__ == "__main__":
    main()
