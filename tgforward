#!/usr/bin/env python3
"""tgforward - Telegram forward-to-group bot daemon.

Listens for messages sent to the bot (via long polling getUpdates).
When an allowed user forwards a message (or sends media directly),
downloads the media and re-posts it to the target group with:
  - original channel/group info + hyperlink to the original message
  - original caption preserved
  - video dimensions/duration probed via ffprobe (no stretching)

Access control: only usernames in .allowed_users (one per line) can use it.

Usage: tgforward  (runs forever; manage via systemd)
"""
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.parse

DIR = "/home/hatch/workspace/tools/tgapi"
API = "http://127.0.0.1:8081"
DATA_DIR = os.path.join(DIR, "data", "forward")
os.makedirs(DATA_DIR, exist_ok=True)

TOKEN = open(os.path.join(DIR, ".bot_token")).read().strip()
TARGET_CHAT = open(os.path.join(DIR, ".chat_id")).read().strip()
ALLOWED = set(
    line.strip().lstrip("@").lower()
    for line in open(os.path.join(DIR, ".allowed_users"))
    if line.strip()
)
OFFSET_FILE = os.path.join(DIR, "data", "forward_offset.txt")

# X video handling
X_URL_RE = re.compile(r"https?://(?:www\.)?(?:x\.com|twitter\.com)/(\w+)/status/(\d+)")
FX_API = "https://api.fxtwitter.com"
MAX_TG_FILE = 1900 * 1024 * 1024  # split threshold (under the 2000MB Bot API limit)
UA = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15"


def api(method, params=None, files=None, timeout=120):
    """Call the local Bot API. Returns the parsed JSON result."""
    url = f"{API}/bot{TOKEN}/{method}"
    if files:
        # multipart via curl (handles big files reliably)
        cmd = ["curl", "-s", "-m", str(timeout), url]
        for k, v in (params or {}).items():
            cmd += ["--form-string", f"{k}={v}"]
        for k, path in files.items():
            cmd += ["-F", f"{k}=@{path}"]
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 30)
        return json.loads(out.stdout)
    data = urllib.parse.urlencode(params or {}).encode()
    req = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def get_offset():
    try:
        return int(open(OFFSET_FILE).read().strip())
    except (FileNotFoundError, ValueError):
        return 0


def save_offset(off):
    open(OFFSET_FILE, "w").write(str(off))


def ffprobe_video(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error",
         "-show_entries", "stream=width,height",
         "-show_entries", "format=duration",
         "-of", "json", path],
        capture_output=True, text=True, check=True).stdout
    d = json.loads(out)
    st = d["streams"][0]
    return int(st["width"]), int(st["height"]), int(float(d["format"]["duration"]))


def download_file(file_id, dest):
    """Download via getFile (local Bot API returns a local path)."""
    r = api("getFile", {"file_id": file_id})
    if not r.get("ok"):
        raise RuntimeError(f"getFile failed: {r}")
    fpath = r["result"]["file_path"]
    # local mode: file_path is already on disk under the server's data dir
    # Try common locations
    candidates = [
        fpath,
        os.path.join(DIR, "data", fpath),
        os.path.join("/home/hatch", ".local", "share", "telegram-bot-api", fpath),
    ]
    for c in candidates:
        if os.path.isfile(c):
            subprocess.run(["cp", c, dest], check=True)
            return dest
    # Fallback: download via file URL
    url = f"{API}/file/bot{TOKEN}/{fpath}"
    urllib.request.urlretrieve(url, dest)
    return dest


def source_link(fwd_chat, fwd_msg_id):
    """Build a t.me link to the original message."""
    if not fwd_chat or not fwd_msg_id:
        return None
    if fwd_chat.get("username"):
        return f"https://t.me/{fwd_chat['username']}/{fwd_msg_id}"
    # private chat: strip -100 prefix
    cid = str(fwd_chat["id"])
    if cid.startswith("-100"):
        cid = cid[4:]
    else:
        cid = cid.lstrip("-")
    return f"https://t.me/c/{cid}/{fwd_msg_id}"


def source_name(fwd_chat, fwd_sender_name):
    if fwd_chat:
        title = fwd_chat.get("title") or fwd_chat.get("username") or "Unknown"
        kind = {"channel": "频道", "supergroup": "群组", "group": "群组"}.get(
            fwd_chat.get("type"), "会话")
        return f"{title}（{kind}）"
    if fwd_sender_name:
        return fwd_sender_name + "（个人）"
    return "未知来源"


def build_caption(msg, fwd_chat, fwd_msg_id, fwd_sender_name):
    """HTML caption: original caption + source info with hyperlink."""
    orig_caption = msg.get("caption") or ""
    orig_text = msg.get("text") or ""
    body = orig_caption or orig_text

    link = source_link(fwd_chat, fwd_msg_id)
    src = source_name(fwd_chat, fwd_sender_name)

    parts = []
    if body:
        parts.append(html.escape(body))
    if link:
        parts.append(f'\n\n来源：<a href="{html.escape(link, quote=True)}">{html.escape(src)}</a>')
    else:
        parts.append(f'\n\n来源：{html.escape(src)}')
    parts.append('\n#转发存档')
    return "".join(parts)


def download_url(url, dest, retries=5):
    """Download a URL with curl, resume + retry."""
    for attempt in range(retries):
        r = subprocess.run(
            ["curl", "-C", "-", "--retry", "3", "--retry-delay", "5",
             "-L", "-A", UA, "-o", dest, url],
            capture_output=True, text=True, timeout=1800)
        if r.returncode == 0 and os.path.isfile(dest) and os.path.getsize(dest) > 0:
            return dest
        time.sleep(min(2 ** attempt, 30))
    raise RuntimeError(f"download failed after {retries} attempts: {url[:80]}")


def fx_best_video(tweet_user, tweet_id):
    """Query fxtwitter API, return (best_mp4_url, author_name, author_handle, text)."""
    api_url = f"{FX_API}/{tweet_user}/status/{tweet_id}"
    # use curl (not urllib): urllib's proxy handling breaks TLS here
    out = subprocess.run(
        ["curl", "-s", "-m", "30", "-A", UA, api_url],
        capture_output=True, text=True, timeout=40).stdout
    d = json.loads(out)
    if d.get("code") != 200:
        raise RuntimeError(f"fxtwitter API error: {d.get('code')}")
    t = d["tweet"]
    author = t.get("author", {})
    videos = (t.get("media") or {}).get("videos") or []
    if not videos:
        raise RuntimeError("no video in tweet")
    best_url, best_res = None, 0
    for fmt in videos[0].get("formats", []):
        url = fmt.get("url", "")
        if not url.endswith(".mp4") and ".mp4?" not in url:
            continue
        m = re.search(r"/(\d+)x(\d+)/", url)
        if m:
            res = int(m.group(1)) * int(m.group(2))
            if res > best_res:
                best_res, best_url = res, url
    if not best_url:
        raise RuntimeError("no mp4 format found")
    return (best_url,
            author.get("name", tweet_user),
            author.get("screen_name", tweet_user),
            t.get("text", ""))


def split_video(path, max_bytes=MAX_TG_FILE):
    """Split a video into <max_bytes parts (no re-encode). Returns [paths]."""
    if os.path.getsize(path) <= max_bytes:
        return [path]
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "csv=p=0", path],
        capture_output=True, text=True, check=True).stdout
    dur = float(out.strip())
    # estimate number of parts by size
    n = int(os.path.getsize(path) // max_bytes) + 1
    seg = dur / n
    parts = []
    base, ext = os.path.splitext(path)
    for i in range(n):
        p = f"{base}_p{i+1}of{n}{ext}"
        subprocess.run(
            ["ffmpeg", "-y", "-v", "error", "-ss", str(seg * i),
             "-i", path, "-c", "copy", "-t", str(seg), p],
            check=True)
        parts.append(p)
    return parts


def send_video_file(path, caption):
    """Send a video file to the target group. Returns True on success."""
    w, h, dur = ffprobe_video(path)
    for attempt in range(3):
        r = api("sendVideo", {
            "chat_id": TARGET_CHAT,
            "parse_mode": "HTML",
            "supports_streaming": "true",
            "width": w, "height": h, "duration": dur,
            "caption": caption[:1024],
        }, files={"video": path}, timeout=1800)
        if r.get("ok"):
            return True
        desc = str(r.get("description", ""))
        ra = (r.get("parameters") or {}).get("retry_after")
        if "retry_after" in desc or ra:
            time.sleep((ra or 30) + 2)
            continue
        print(f"sendVideo failed: {r}", flush=True)
        time.sleep(5)
    return False


def build_x_caption(tweet_url, text, author_name, author_handle, part=None):
    handle_tag = author_handle.lstrip("@")
    name_tag = "".join(author_name.split())
    suffix = f" ({part})" if part else ""
    return (
        f'<a href="{html.escape(tweet_url, quote=True)}">{html.escape(text)}</a>{suffix}'
        f'\n\n博主：{html.escape(author_name)} @{html.escape(handle_tag)}'
        f'\n#{handle_tag} #{name_tag} #X视频下载'
    )


def handle_x_link(url, msg_id, user_chat_id):
    """Download X video and send to group. Sends progress updates to the user.
    Returns True if handled."""
    m = X_URL_RE.search(url)
    if not m:
        return False
    tweet_user, tweet_id = m.group(1), m.group(2)
    tweet_url = f"https://x.com/{tweet_user}/status/{tweet_id}"
    tmp = os.path.join(DATA_DIR, f"x_{msg_id}_{tweet_id}.mp4")

    def progress(text):
        print(f"[x:{tweet_id}] {text}", flush=True)
        try:
            api("sendMessage", {"chat_id": user_chat_id, "text": text})
        except Exception:
            pass

    try:
        progress(f"🔗 收到 X 链接，开始解析…\n{tweet_url}")
        best_url, author_name, author_handle, text = fx_best_video(tweet_user, tweet_id)
        # probe remote size for the progress message
        try:
            hr = subprocess.run(
                ["curl", "-sI", "-m", "20", "-A", UA, best_url],
                capture_output=True, text=True, timeout=25).stdout
            mm = re.search(r"content-length:\s*(\d+)", hr, re.I)
            size_mb = int(mm.group(1)) // (1024 * 1024) if mm else None
        except Exception:
            size_mb = None
        size_hint = f"（约 {size_mb}MB，1080p）" if size_mb else "（1080p）"
        progress(f"✅ 解析成功：{author_name} @{author_handle}\n⬇️ 开始下载{size_hint}…")
        download_url(best_url, tmp)
        actual_mb = os.path.getsize(tmp) // (1024 * 1024)
        parts = split_video(tmp)
        total = len(parts)
        if total > 1:
            progress(f"✅ 下载完成（{actual_mb}MB），超过 2GB，切成 {total} 段上传…")
        else:
            progress(f"✅ 下载完成（{actual_mb}MB），正在转发到群里…")
        ok_all = True
        for i, p in enumerate(parts):
            if total > 1:
                progress(f"📤 正在上传第 {i+1}/{total} 段…")
            part_label = f"{i+1}/{total}" if total > 1 else None
            caption = build_x_caption(tweet_url, text or "X视频", author_name,
                                      author_handle, part_label)
            if not send_video_file(p, caption):
                ok_all = False
        if ok_all:
            progress(f"🎉 转发完成，共 {total} 段，已发到群里")
        else:
            progress(f"❌ 转发失败，请检查日志")
        print(f"X video {tweet_id} -> group {'ok' if ok_all else 'FAILED'} "
              f"({total} part(s))", flush=True)
        return True
    except Exception as e:
        print(f"X link handling failed for {tweet_url}: {e}", flush=True)
        progress(f"❌ 处理失败：{tweet_url}\n原因：{e}")
        return True
    finally:
        for f in os.listdir(DATA_DIR):
            if f.startswith(f"x_{msg_id}_{tweet_id}"):
                try:
                    os.remove(os.path.join(DATA_DIR, f))
                except OSError:
                    pass


def handle_message(msg):
    frm = msg.get("from", {})
    username = (frm.get("username") or "").lower()
    if username not in ALLOWED:
        print(f"ignoring message from @{username} (not allowed)", flush=True)
        return

    fwd_chat = msg.get("forward_from_chat")
    fwd_msg_id = msg.get("forward_from_message_id")
    fwd_sender = msg.get("forward_sender_name")
    # also support forward_from (user) for completeness
    if not fwd_sender and msg.get("forward_from"):
        f = msg["forward_from"]
        fwd_sender = f.get("first_name", "") + (" " + f.get("last_name", "") if f.get("last_name") else "")

    # X link? download the video and post it directly (no Muse involved)
    text = msg.get("text") or msg.get("caption") or ""
    xm = X_URL_RE.search(text)
    if xm and not fwd_chat:
        handle_x_link(xm.group(0), msg["message_id"], msg["chat"]["id"])
        return

    caption = build_caption(msg, fwd_chat, fwd_msg_id, fwd_sender)
    tmp = os.path.join(DATA_DIR, f"fwd_{msg['message_id']}")

    try:
        if "video" in msg:
            v = msg["video"]
            dest = tmp + ".mp4"
            download_file(v["file_id"], dest)
            w, h, dur = ffprobe_video(dest)
            r = api("sendVideo", {
                "chat_id": TARGET_CHAT,
                "parse_mode": "HTML",
                "supports_streaming": "true",
                "width": w, "height": h, "duration": dur,
                "caption": caption[:1024],
            }, files={"video": dest}, timeout=1800)
        elif "photo" in msg:
            p = msg["photo"][-1]  # largest
            dest = tmp + ".jpg"
            download_file(p["file_id"], dest)
            r = api("sendPhoto", {
                "chat_id": TARGET_CHAT,
                "parse_mode": "HTML",
                "caption": caption[:1024],
            }, files={"photo": dest}, timeout=600)
        elif "animation" in msg:
            a = msg["animation"]
            dest = tmp + ".mp4"
            download_file(a["file_id"], dest)
            r = api("sendAnimation", {
                "chat_id": TARGET_CHAT,
                "parse_mode": "HTML",
                "caption": caption[:1024],
            }, files={"animation": dest}, timeout=600)
        elif "document" in msg:
            d = msg["document"]
            ext = os.path.splitext(d.get("file_name", ""))[1] or ".bin"
            dest = tmp + ext
            download_file(d["file_id"], dest)
            r = api("sendDocument", {
                "chat_id": TARGET_CHAT,
                "parse_mode": "HTML",
                "caption": caption[:1024],
            }, files={"document": dest}, timeout=1800)
        elif "text" in msg:
            r = api("sendMessage", {
                "chat_id": TARGET_CHAT,
                "parse_mode": "HTML",
                "text": caption[:4096],
            })
        else:
            print(f"unsupported message type, keys={list(msg.keys())}", flush=True)
            return

        if r.get("ok"):
            print(f"forwarded msg {msg['message_id']} -> group ok", flush=True)
        else:
            print(f"send failed: {r}", flush=True)
    except Exception as e:
        print(f"error handling msg {msg.get('message_id')}: {e}", flush=True)
    finally:
        # always clean up downloaded files
        for f in os.listdir(DATA_DIR):
            if f.startswith(f"fwd_{msg['message_id']}"):
                try:
                    os.remove(os.path.join(DATA_DIR, f))
                except OSError:
                    pass


def main():
    print(f"tgforward started, allowed users: {sorted(ALLOWED)}", flush=True)
    offset = get_offset()
    backoff = 5
    while True:
        try:
            r = api("getUpdates", {"offset": offset, "timeout": 50}, timeout=70)
            if not r.get("ok"):
                print(f"getUpdates error: {r}", flush=True)
                time.sleep(backoff)
                backoff = min(backoff * 2, 60)
                continue
            backoff = 5  # reset on success
            for upd in r["result"]:
                offset = upd["update_id"] + 1
                save_offset(offset)
                msg = upd.get("message")
                if msg:
                    handle_message(msg)
        except Exception as e:
            err = str(e)
            print(f"poll error: {e}", flush=True)
            # 409 Conflict or 429: back off harder
            if "409" in err or "429" in err:
                backoff = min(backoff * 2, 120)
            time.sleep(backoff)


if __name__ == "__main__":
    main()
